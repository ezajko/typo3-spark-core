spark_core {
    pids {
        slimMenu = {$settings.spark_core.pids.slimMenu}
        mainMenu = {$settings.spark_core.pids.mainMenu}
        footerMenu = {$settings.spark_core.pids.footerMenu}
    }
}

styles.templates {
    templateRootPath = EXT:spark_core/Resources/Private/Extensions/fluid_styled_content/Templates/
    partialRootPath = EXT:spark_core/Resources/Private/Extensions/fluid_styled_content/Partials/
    layoutRootPath = EXT:spark_core/Resources/Private/Extensions/fluid_styled_content/Layouts/
}
