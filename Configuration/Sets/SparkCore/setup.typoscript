# Import Helper
@import 'EXT:spark_core/Configuration/TypoScript/Helper/DynamicContent.typoscript'

# Import Setup Modules
@import 'EXT:fluid_styled_content/Configuration/TypoScript/setup.typoscript'

lib.contentElement {
    templateRootPaths {
        10 = EXT:spark_core/Resources/Private/Templates/ContentElements/
        20 = {$styles.templates.templateRootPath}
    }
    partialRootPaths {
        10 = EXT:spark_core/Resources/Private/Partials/ContentElements/
        20 = {$styles.templates.partialRootPath}
    }
    includeJSFooter {
        bootstrap = https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js
    }
    layoutRootPaths {
        10 = EXT:spark_core/Resources/Private/Layouts/ContentElements/
        20 = {$styles.templates.layoutRootPath}
    }
}

@import 'EXT:spark_core/Configuration/TypoScript/Setup/Page.typoscript'

# Faker Configuration
module.tx_faker {
    tables {
        tx_news_domain_model_news {
            fields {
                title = sentence
                bodytext = paragraphs
                datetime = dateTimeBetween
                # Event specific fields
                is_event = digit
                event_end = dateTimeBetween
                organizer = name
                location = city
            }
        }
    }
}
