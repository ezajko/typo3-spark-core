# Helper object to fetch page title by UID (passed as current value)
lib.pageTitle = RECORDS
lib.pageTitle {
    source.current = 1
    tables = pages
    conf.pages = TEXT
    conf.pages.field = title
    conf.pages.htmlSpecialChars = 1
}

# PAGE Object definition
page = PAGE
page {
    typeNum = 0

    # Dynamic Template Selection based on backend_layout
    10 = FLUIDTEMPLATE
    10 {
        templateName = TEXT
        templateName {
            cObject = TEXT
            cObject {
                data = pagelayout
                required = 1
                split {
                    token = pagets__
                    cObjNum = 1
                    1.current = 1
                }
            }
            ifEmpty = Default
        }

        templateRootPaths {
            10 = EXT:spark_core/Resources/Private/Templates/Page/
        }
        partialRootPaths {
            10 = EXT:spark_core/Resources/Private/Partials/
            20 = {$styles.templates.partialRootPath}
        }
        layoutRootPaths {
            10 = EXT:spark_core/Resources/Private/Layouts/
            20 = {$styles.templates.layoutRootPath}
        }

        # Data Processing
        dataProcessing {
            10 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            10 {
                special = directory
                special.value = {$spark_core.pids.mainMenu}
                levels = 6
                includeSpacer = 1
                includeNotInMenu = 1
                as = mainnavigation
            }

            20 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            20 {
                special = rootline
                special.range = 0|-1
                includeNotInMenu = 1
                as = breadcrumbs
            }

            30 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            30 {
                entryLevel = 0
                levels = 4
                expandAll = 0
                includeSpacer = 1
                titleField = nav_title // title
                as = submenu
            }

            40 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            40 {
                entryLevel = 1
                levels = 2
                expandAll = 0
                includeSpacer = 1
                titleField = nav_title // title
                as = sectionMenu
            }

            50 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            50 {
                special = directory
                special.value = 11
                levels = 3
                includeNotInMenu = 1
                as = slimnavigation
            }

            60 = TYPO3\CMS\Frontend\DataProcessing\LanguageMenuProcessor
            60 {
                #special = language
                #special.value = 1,0
                #addQueryString = 1
                #addQueryString.exclude = L,id,cHash,no_cache
                #addQueryString.method = GET
                languages = auto
                as = languageMenu
            }

            70 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            70 {
                special = directory
                special.value = {$spark_core.pids.footerMenu}
                levels = 1
                includeNotInMenu = 1
                as = footerNavigation
            }

            80 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            80 {
                entryLevel = 0
                levels = 6
                expandAll = 1
                includeSpacer = 1
                titleField = nav_title // title
                as = mobilenavigation
            }

            90 = TYPO3\CMS\Frontend\DataProcessing\SiteProcessor
            90 {
                as = site
            }
        }

        # Variables mapped to Content Columns (ColPos)
        variables {
            mainContent < styles.content.get
            mainContent.select.where = colPos=0

            heroContent < styles.content.get
            heroContent.select.where = colPos=3

            sidebarContent < styles.content.get
            sidebarContent.select.where = colPos=1

            sidebarRightContent < styles.content.get
            sidebarRightContent.select.where = colPos=2

            contentBefore < styles.content.get
            contentBefore.select.where = colPos=10

            contentAfter < styles.content.get
            contentAfter.select.where = colPos=11
        }
    }

    # Meta Tags
    meta {
        viewport = width=device-width, initial-scale=1
        X-UA-Compatible = IE=edge
        X-UA-Compatible.attribute = http-equiv
    }

    # Include Assets from Build
    includeCSS {
        site = EXT:spark_core/Resources/Public/Css/site.css
    }

    includeJSFooter {
        main = EXT:spark_core/Resources/Public/JavaScript/main.js
        main.defer = 1
    }
}
