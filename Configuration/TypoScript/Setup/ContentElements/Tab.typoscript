tt_content.tab < lib.contentElement
tt_content.tab {
    templateName = Tab
    dataProcessing {
        10 = B13\Container\DataProcessing\ContainerProcessor
        
        20 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
        20 {
            table = tt_content
            pidInList.field = pid
            where = tx_container_parent = ###uid### AND colPos = 200
            orderBy = sorting
            as = tabItems
        }
    }
}

tt_content.tab_item < lib.contentElement
tt_content.tab_item {
    templateName = TabItem
    dataProcessing {
        10 = B13\Container\DataProcessing\ContainerProcessor
    }
}
