# Base Grid Element
lib.gridElement < lib.contentElement
lib.gridElement {
    dataProcessing {
        10 = B13\Container\DataProcessing\ContainerProcessor
    }
}

# 2 Columns
tt_content.container_2_columns < lib.gridElement
tt_content.container_2_columns {
    templateName = Grid2Col
}

tt_content.container_2_columns_right < lib.gridElement
tt_content.container_2_columns_right {
    templateName = Grid2ColRight
}

tt_content.container_2_columns_left < lib.gridElement
tt_content.container_2_columns_left {
    templateName = Grid2ColLeft
}

tt_content.container_2_columns_25_75 < lib.gridElement
tt_content.container_2_columns_25_75 {
    templateName = Grid2Col2575
}

tt_content.container_2_columns_75_25 < lib.gridElement
tt_content.container_2_columns_75_25 {
    templateName = Grid2Col7525
}

# 3 Columns
