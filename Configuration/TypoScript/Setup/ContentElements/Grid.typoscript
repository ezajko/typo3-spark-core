# 2 Columns
tt_content.container_2_columns < lib.contentElement
tt_content.container_2_columns {
    templateName = Grid2Col
    dataProcessing {
        10 = B13\Container\DataProcessing\ContainerProcessor
        10 {
            colPos = 201,202
            as = children
        }
    }
}

