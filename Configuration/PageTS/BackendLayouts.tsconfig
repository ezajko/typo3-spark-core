mod.web_layout.BackendLayouts {
    Default {
        title = Default
        config {
            backend_layout {
                colCount = 1
                rowCount = 1
                rows {
                    1 {
                        columns {
                            1 {
                                name = Main Content
                                colPos = 0
                            }
                        }
                    }
                    2 {
                        columns {
                            1 {
                                name = Content Before
                                colPos = 10
                            }
                        }
                    }
                    3 {
                        columns {
                            1 {
                                name = Content After
                                colPos = 11
                            }
                        }
                    }
                }
            }
        }
    }
